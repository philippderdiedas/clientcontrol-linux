[Unit]
Description=Kiosk-Datenbereich mounten (USB ext4, sonst tmpfs)
Documentation=file:///usr/local/bin/kiosk-data-mount
After=local-fs.target systemd-udevd.service
# Muss fertig sein, bevor der autologin auf tty1 sway startet - sway liest
# seine Output-Overrides aus dem Datenbereich.
Before=getty@tty1.service
ConditionPathExists=/usr/local/bin/kiosk-data-mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/kiosk-data-mount
# Beim Stoppen nicht unmounten - der Kiosk faehrt sowieso runter, und ein
# umount waehrend miniclientcontrol noch in die SQLite-DB schreibt waere
# schlimmer als ein unsauberes Dateisystem.
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
