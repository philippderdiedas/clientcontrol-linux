#!/usr/bin/env bash
# Startet miniclientcontrol in der laufenden sway-Session.
#
# Wird aus ~/.config/sway/config per exec aufgerufen, NICHT als systemd-Unit:
# miniclientcontrol startet Chromium selbst und braucht dafuer WAYLAND_DISPLAY
# und XDG_RUNTIME_DIR aus der Session.
#
# Konfiguration, in dieser Reihenfolge - spaeter gewinnt:
#   1. /etc/default/miniclientcontrol            (im Image, unveraenderlich)
#   2. <datenmount>/miniclientcontrol.env        (vom USB-Stick, optional)
#   3. MCC_EXTRA_ARGS aus einer der beiden       (rohe CLI-Flags)
#
# Weil in miniclientcontrol jedes Argument als #[arg(long, env)] deklariert ist,
# wirkt jede exportierte Variable direkt als Flag: PORT=8080 entspricht
# --port 8080, HTTP_LISTEN=0.0.0.0 entspricht --http-listen 0.0.0.0 usw.
# Deshalb wird hier mit `set -a` gesourct.

set -euo pipefail

log() { printf 'kiosk-session: %s\n' "$*"; }

set -a
# shellcheck disable=SC1091
[[ -r /etc/default/miniclientcontrol ]] && . /etc/default/miniclientcontrol

DATA="${KIOSK_DATA_DIR:-/var/lib/miniclientcontrol}"

# Override vom persistenten Datentraeger. Steckt kein Stick, ist der Mount ein
# tmpfs und die Datei existiert nicht - dann bleibt es bei den Image-Defaults.
if [[ -r "${DATA}/miniclientcontrol.env" ]]; then
    log "lade Override ${DATA}/miniclientcontrol.env"
    # shellcheck disable=SC1091,SC1090
    . "${DATA}/miniclientcontrol.env"
else
    log "kein Override auf dem Datenbereich, nutze Image-Defaults"
fi
set +a

mkdir -p -- "${DATA}/assets"

# Backlight auf volle Helligkeit. Ein Kiosk soll hell leuchten, aber manche
# Panels booten gedimmt. Fuer jedes Backlight im sysfs die maximale Helligkeit
# setzen (max_brightness -> brightness). Kein Backlight (externer Monitor ohne
# steuerbares Backlight) -> der Glob matcht nichts und die Schleife laeuft leer.
for bl in /sys/class/backlight/*; do
    [[ -f "${bl}/max_brightness" && -w "${bl}/brightness" ]] || continue
    if cat "${bl}/max_brightness" > "${bl}/brightness" 2>/dev/null; then
        log "Backlight $(basename "${bl}") auf max gesetzt"
    else
        log "WARNUNG: Backlight $(basename "${bl}") liess sich nicht setzen"
    fi
done

# Rohe Flags aus MCC_EXTRA_ARGS. Wortweise getrennt, keine Quotes innerhalb -
# Argumente mit Leerzeichen gehoeren als Env-Variable gesetzt, nicht hierher.
extra=()
if [[ -n "${MCC_EXTRA_ARGS:-}" ]]; then
    read -ra extra <<<"${MCC_EXTRA_ARGS}"
    log "zusaetzliche Flags: ${extra[*]}"
fi

# --- Multi-Display-Discovery --------------------------------------------
# sway ist hier schon oben (kiosk-session laeuft aus der sway-Config per exec),
# also kennt es seine Outputs. kiosk-discover-displays gibt die aktiven Connector
# aus, aber nur ab zwei Monitoren - bei einem bleibt die Liste leer und
# miniclientcontrol startet ohne --display, exakt wie bisher (Legacy).
#
# Pro Connector wird VOR dem Start eine Platzierungsregel gesetzt: das Fenster
# mit app_id "miniclientcontrol-<connector>" (den app_id leitet miniclientcontrol
# aus dem Display-Namen ab) wandert auf genau diesen Output. Die Regel muss
# stehen, bevor miniclientcontrol das Fenster oeffnet, sonst erscheint es kurz
# auf dem falschen Monitor.
display_flags=()
mapfile -t kiosk_displays < <(swaymsg -t get_outputs | kiosk-discover-displays)
for out in "${kiosk_displays[@]}"; do
    display_flags+=(--display "${out}")
    swaymsg "for_window [app_id=\"miniclientcontrol-${out}\"] move container to output ${out}"
    log "Display ${out} deklariert und auf Output ${out} gebunden"
done
if (( ${#display_flags[@]} == 0 )); then
    log "ein Monitor oder keiner - Legacy-Start ohne --display"
fi

# Fullscreen NICHT in der for_window-Regel: die greift beim Mappen des Fensters,
# aber Chromiums --kiosk setzt seinen eigenen Fullscreen teils erst danach und
# ueberschreibt sie - gemessen blieb dann ein Fenster fs=0, das andere fs=1,
# nicht deterministisch. Stattdessen nach dem Start wiederholt durchsetzen:
# ein Hintergrundprozess (Fork VOR dem exec, ueberlebt es also) setzt ueber die
# ersten ~15s mehrfach "fullscreen enable". Idempotent, und der letzte Durchlauf
# liegt sicher nach Chromiums Fullscreen-Request, egal wie das Race ausgeht.
if (( ${#display_flags[@]} >= 2 )); then
    (
        for _ in 1 2 3 4 5 6; do
            sleep 3
            for out in "${kiosk_displays[@]}"; do
                swaymsg "[app_id=\"miniclientcontrol-${out}\"] fullscreen enable" >/dev/null 2>&1 || true
            done
        done
    ) &
fi

# --no-sandbox: Chromium laeuft hier als root und verweigert sonst den Start.
# --ozone-platform=wayland: sonst faellt es auf X11 zurueck, das es nicht gibt.
# miniclientcontrol startet Chromium selbst (siehe --no-launch-browser in
# seiner Hilfe), deshalb wird Chromium hier NICHT separat gestartet.
exec /usr/local/bin/miniclientcontrol \
    --assets-dir "${DATA}/assets" \
    --database-path "${DATA}/miniclient.db" \
    --chromium-arg=--no-sandbox \
    --chromium-arg=--ozone-platform=wayland \
    "${display_flags[@]}" \
    "${extra[@]}"
