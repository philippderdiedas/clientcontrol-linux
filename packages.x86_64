# --- Kernel & Firmware ---
linux
linux-firmware
intel-ucode
amd-ucode

# --- Basissystem (zwingend) ---
base
sudo
openssh

# --- initramfs / PXE-Boot (zwingend für unser Setup) ---
mkinitcpio
mkinitcpio-archiso
mkinitcpio-nfs-utils

# --- Bootloader (für ISO-Build selbst, syslinux-Bootmode in profiledef.sh) ---
syslinux

# --- Netzwerk zur Laufzeit (nach dem Boot, für Chromium & SSH) ---
dhcpcd

# --- Grafikstack & Wayland ---
sway
swaybg

# --- Audio (für Chromium-Medien) ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
# libpulse liefert `pactl`, mit dem miniclientcontrol (src/audio.rs) die
# Raum-Audio-Senken steuert. pipewire-pulse ist nur der Server, nicht der Client.
libpulse

# --- Webbrowser & Schriften ---
chromium
xdg-utils
ttf-dejavu
ttf-liberation

# --- mDNS / Zeroconf (fuer --public-url mdns und --managed-cert) ---
# avahi-publish veroeffentlicht den .local-Namen; der avahi-daemon wird per
# multi-user.target.wants aktiviert. Ohne faellt managed-cert weich zurueck.
avahi

# --- Kiosk-Werkzeuge (Laufzeit) ---
# jq: kiosk-session parst damit die JSON-Ausgabe von "swaymsg -t get_outputs"
# fuer die Multi-Display-Discovery.
jq
